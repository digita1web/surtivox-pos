{
  "expo": {
    "name": "Surtivox POS",
    "slug": "surtivox-pos",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "surtivoxpos",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "io.surtivox.pos",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E12"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.surtivox.pos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Surtivox POS uses the camera to scan product barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Surtivox POS uses your photos to set product images.",
          "cameraPermission": "Surtivox POS uses the camera to take product photos."
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0E12"
        }
      ],
      "expo-asset",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "jsEngine": "hermes"
  }
}
