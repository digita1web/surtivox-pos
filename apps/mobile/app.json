{
  "expo": {
    "name": "Surtivox POS",
    "slug": "digita1web",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "surtivoxpos",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "io.surtivox.pos",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E12"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.surtivox.pos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Surtivox POS usa la cámara para escanear códigos de barras de productos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Surtivox POS usa tus fotos para asignar imágenes a los productos.",
          "cameraPermission": "Surtivox POS usa la cámara para tomar fotos de productos.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0E12"
        }
      ],
      "expo-asset",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "jsEngine": "hermes",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/e9fd4450-8f1d-4490-be62-34de756bf454"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9fd4450-8f1d-4490-be62-34de756bf454"
      }
    },
    "owner": "digita1webm"
  }
}
