{
  "name": "surtivox-catalog",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "description": "Catalogo comunitario anonimo para Surtivox POS",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create surtivox-catalog",
    "db:schema": "wrangler d1 execute surtivox-catalog --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute surtivox-catalog --local --file=./schema.sql",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  }
}
